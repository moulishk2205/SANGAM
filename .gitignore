# data is never committed — provenance is tracked in docs/DATA_PROVENANCE.md
data/
*.zip
*.csv
*.xlsx
*.parquet
# models/* not models/ — an excluded DIRECTORY cannot be re-entered by a later
# negation, so the pattern has to exclude its contents instead.
models/*
# ...but the fitted scorer ships. It is 17 KB of named coefficients, not a
# 128 MB checkpoint, and without it a fresh clone silently falls back to the
# deterministic path and reports uncalibrated scores with no sign anything is
# missing. Retraining it needs the corpus and ~50 s; committing it costs nothing.
!models/scorer/
!models/scorer/*.json
.venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.DS_Store
.env
node_modules/

# frontend
web/node_modules/
web/dist/
web/.vite/

# local database — regenerated by `alembic upgrade head` + seeding on startup
sangam.db
sangam.db-wal
sangam.db-shm
