{
  // Terminal > Run Task…  (or Cmd/Ctrl+Shift+P > "Tasks: Run Task")
  //
  // "SANGAM: start everything" runs the engine and the web app side by side in
  // two terminal panes. Both are long-running servers, so neither ever reports
  // "done" — that is expected, not a hang.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "SANGAM: engine (API on :8001)",
      "type": "shell",
      // cwd is the repository root on purpose. src/nmc/match/retrieve.py looks
      // for the embedding model at the RELATIVE path models/bge-small-en-v1.5,
      // so starting from any other directory silently falls back to
      // re-downloading it from Hugging Face.
      "options": { "cwd": "${workspaceFolder}" },
      "command": "${command:python.interpreterPath} -m uvicorn src.nmc.api:app --port 8001 --reload",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "sangam",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "SANGAM: web (Vite dev server)",
      "type": "shell",
      "options": { "cwd": "${workspaceFolder}/web" },
      "command": "npm run dev",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "sangam",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "SANGAM: start everything",
      "dependsOn": [
        "SANGAM: engine (API on :8001)",
        "SANGAM: web (Vite dev server)"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "SANGAM: run engine tests",
      "type": "shell",
      "options": { "cwd": "${workspaceFolder}" },
      "command": "${command:python.interpreterPath} -m pytest tests/ -q",
      "problemMatcher": [],
      "group": { "kind": "test", "isDefault": true }
    },
    {
      "label": "SANGAM: evaluate the engine",
      "type": "shell",
      "options": { "cwd": "${workspaceFolder}" },
      "command": "${command:python.interpreterPath} scripts/evaluate.py",
      "problemMatcher": []
    },
    {
      "label": "SANGAM: pre-download the embedding model (for offline demos)",
      "type": "shell",
      "options": { "cwd": "${workspaceFolder}" },
      "command": "${command:python.interpreterPath} -c \"from sentence_transformers import SentenceTransformer; SentenceTransformer('BAAI/bge-small-en-v1.5').save('models/bge-small-en-v1.5')\"",
      "problemMatcher": []
    }
  ]
}
