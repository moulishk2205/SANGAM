{
  // The interpreter inside the project venv. Point this elsewhere if you put
  // your venv somewhere else; on Windows the path is .venv\\Scripts\\python.exe
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["tests"],
  "python.analysis.extraPaths": ["${workspaceFolder}"],
  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true
  },
  // These are gigabytes of model weights and fetched catalogue data. Indexing
  // them makes search unusable.
  "search.exclude": {
    "**/.venv": true,
    "**/node_modules": true,
    "**/data": true,
    "**/models": true,
    "**/web/dist": true
  }
}
